<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Safe Spaces at Golden Valley School</title>
    <!-- Tailwind CSS CDN --><
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandMain: '#12519C',
                        brandAccent: '#27A0DB',
                        brandHighlight: '#F6C401',
                    },
                    fontFamily: {
                        sans: ['Arial', 'Helvetica', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom base styles ensuring Arial typography and strict color palette adherence */
        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #FFFFFF;
            color: #1F2937;
            overflow-x: hidden;
        }
        .text-brand-title {
            color: #12519C;
        }
        .bg-brand-title {
            background-color: #12519C;
        }
        .text-brand-accent {
            color: #27A0DB;
        }
        .bg-brand-accent {
            background-color: #27A0DB;
        }
        .bg-brand-highlight {
            background-color: #F6C401;
        }
        .border-brand-highlight {
            border-color: #F6C401;
        }
        /* Custom scrollbar styling */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F3F4F6;
        }
        ::-webkit-scrollbar-thumb {
            background: #27A0DB;
            border-radius: 4px;
        }
        /* Pictogram grid icon animations */
        .person-icon {
            transition: all 0.25s ease-in-out;
        }
        .person-icon:hover {
            transform: scale(1.2);
        }
    </style>
</head>
<body class="bg-white min-h-screen flex flex-col justify-between antialiased">

    <!-- NAVIGATION & HEADER -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <!-- Logo & School Name -->
                <a href="#" class="flex items-center gap-3 group focus:outline-none">
                    <div class="w-10 h-10 rounded-lg bg-[#12519C] flex items-center justify-center text-white shadow-md group-hover:bg-[#27A0DB] transition-colors">
                        <!-- Shield SVG Icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-lg sm:text-xl font-bold tracking-tight text-[#12519C]">Safe Spaces</span>
                        <span class="text-xs text-gray-500 font-medium tracking-wide uppercase">Golden Valley School</span>
                    </div>
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="hidden md:flex items-center space-x-8">
                    <a href="#what-is-safe-space" class="text-sm font-semibold text-gray-700 hover:text-[#12519C] transition-colors">What is a Safe Space</a>
                    <a href="#about-us" class="text-sm font-semibold text-gray-700 hover:text-[#12519C] transition-colors">About Us</a>
                    <a href="#dashboard" class="text-sm font-semibold text-gray-700 hover:text-[#12519C] transition-colors">Dashboard</a>
                    <a href="#get-help" class="px-4 py-2 rounded-lg bg-[#12519C] text-white text-sm font-bold hover:bg-[#27A0DB] transition-colors shadow-sm">Get Help</a>
                </nav>

                <!-- Mobile Navigation Toggle -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" type="button" class="p-2 rounded-md text-gray-700 hover:text-[#12519C] focus:outline-none" aria-label="Toggle Navigation">
                        <svg id="menu-icon-open" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <svg id="menu-icon-close" class="hidden w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Thin Three-Color Bar Under Header (#12519C, #27A0DB, #F6C401) -->
        <div class="w-full h-1.5 flex">
            <div class="w-1/3 bg-[#12519C]"></div>
            <div class="w-1/3 bg-[#27A0DB]"></div>
            <div class="w-1/3 bg-[#F6C401]"></div>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-gray-200 px-4 pt-2 pb-6 space-y-3">
            <a href="#what-is-safe-space" class="mobile-link block py-2 text-base font-semibold text-gray-700 hover:text-[#12519C]">What is a Safe Space</a>
            <a href="#about-us" class="mobile-link block py-2 text-base font-semibold text-gray-700 hover:text-[#12519C]">About Us</a>
            <a href="#dashboard" class="mobile-link block py-2 text-base font-semibold text-gray-700 hover:text-[#12519C]">Dashboard</a>
            <a href="#get-help" class="mobile-link block py-3 text-center rounded-lg bg-[#12519C] text-white font-bold hover:bg-[#27A0DB]">Get Help</a>
        </div>
    </header>

    <main class="flex-grow">
        <!-- SECTION 2: HERO -->
        <section class="py-16 sm:py-24 bg-white">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <!-- Highlight Badge -->
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-xs font-semibold text-[#12519C] mb-6">
                    <span class="w-2 h-2 rounded-full bg-[#F6C401]"></span>
                    Student Awareness Initiative
                </div>

                <!-- Main Title -->
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#12519C] tracking-tight leading-tight mb-8">
                    Bullying Can Affect Your Future
                </h1>

                <!-- Statistic Box with Small Gold Highlight -->
                <div class="max-w-3xl mx-auto mb-10 p-6 sm:p-8 rounded-2xl bg-gray-50 border-l-4 border-[#F6C401] shadow-sm text-left sm:text-center relative">
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                        <div class="p-3 rounded-full bg-blue-100 text-[#12519C] shrink-0">
                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <p class="text-base sm:text-lg text-gray-800 leading-relaxed font-medium">
                            <span class="font-bold text-[#12519C]">1 in 3 students globally</span> experience bullying — ranking among the highest factors degrading future career and mental well-being outcomes.
                        </p>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="flex justify-center">
                    <a href="#get-help" class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-[#27A0DB] text-white text-lg font-bold hover:bg-[#12519C] transition-all transform hover:-translate-y-0.5 shadow-md hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-blue-200">
                        <span>Get Help</span>
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- SECTION 3: WHAT IS A SAFE SPACE -->
        <section id="what-is-safe-space" class="py-16 bg-white border-t border-gray-100">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Section Header -->
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <h2 class="text-2xl sm:text-4xl font-bold text-[#12519C] mb-4">What is a Safe Space?</h2>
                    <p class="text-gray-600 text-base sm:text-lg leading-relaxed">
                        Dedicated to helping victims of bullying while ensuring your information is confidential and will never get leaked or exposed.
                    </p>
                </div>

                <!-- Subtitle for Signs -->
                <div class="text-center mb-8">
                    <span class="inline-block px-3 py-1 rounded-full bg-yellow-50 border border-yellow-200 text-xs font-bold text-gray-800 tracking-wider uppercase">
                        Recognize the Signals
                    </span>
                    <h3 class="text-xl font-bold text-gray-800 mt-2">Three Key Signs of Bullying</h3>
                </div>

                <!-- 3 Cards with Clean Line SVG Icons -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Card 1: Physical Harm -->
                    <div class="p-6 rounded-2xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-all flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-blue-50 text-[#12519C] flex items-center justify-center mb-5 group-hover:bg-[#12519C] group-hover:text-white transition-colors">
                            <!-- Fist / Physical Harm SVG -->
                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h4 class="text-lg font-bold text-[#12519C] mb-2">Physical Harm</h4>
                        <p class="text-gray-600 text-sm leading-relaxed">
                            Hitting you, pushing, tripping, or causing unwanted physical violence and bodily aggression.
                        </p>
                    </div>

                    <!-- Card 2: Verbal Harassment -->
                    <div class="p-6 rounded-2xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-all flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-blue-50 text-[#27A0DB] flex items-center justify-center mb-5 group-hover:bg-[#27A0DB] group-hover:text-white transition-colors">
                            <!-- Chat Bubble / Verbal SVG -->
                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                            </svg>
                        </div>
                        <h4 class="text-lg font-bold text-[#12519C] mb-2">Verbal Harassment</h4>
                        <p class="text-gray-600 text-sm leading-relaxed">
                            Insulting you, name-calling, cruel taunts, or public humiliation designed to break your confidence.
                        </p>
                    </div>

                    <!-- Card 3: Constant Occurrence -->
                    <div class="p-6 rounded-2xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-all flex flex-col items-center text-center group">
                        <div class="w-16 h-16 rounded-2xl bg-yellow-50 text-yellow-700 flex items-center justify-center mb-5 group-hover:bg-[#F6C401] group-hover:text-gray-900 transition-colors">
                            <!-- Calendar / Everyday SVG -->
                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h4 class="text-lg font-bold text-[#12519C] mb-2">Constant Occurrence</h4>
                        <p class="text-gray-600 text-sm leading-relaxed">
                            Happening every day of your life, creating an inescapable cycle of stress, fear, and fatigue.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 4: ABOUT US -->
        <section id="about-us" class="py-16 bg-gray-50 border-t border-b border-gray-100">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <div class="w-12 h-12 rounded-xl bg-blue-100 text-[#12519C] mx-auto flex items-center justify-center mb-4">
                    <!-- User Group SVG -->
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>

                <h2 class="text-2xl sm:text-4xl font-bold text-[#12519C] mb-6">About Us</h2>

                <div class="bg-white p-8 sm:p-10 rounded-2xl shadow-sm border border-gray-100 text-gray-700 text-base sm:text-lg leading-relaxed font-normal">
                    <p class="mb-0">
                        "We are students who see bullying in our school constantly and we know it is bad, so we want to do something about this to stop it in the world and help victims feel safe and secure."
                    </p>
                </div>

                <!-- Core Values Pills -->
                <div class="mt-8 flex flex-wrap justify-center gap-3">
                    <span class="px-4 py-2 rounded-lg bg-white border border-gray-200 text-xs font-bold text-[#12519C] shadow-2xs">Student-Led Action</span>
                    <span class="px-4 py-2 rounded-lg bg-white border border-gray-200 text-xs font-bold text-[#27A0DB] shadow-2xs">100% Confidential</span>
                    <span class="px-4 py-2 rounded-lg bg-white border border-gray-200 text-xs font-bold text-gray-700 shadow-2xs">Empathy & Safety</span>
                </div>
            </div>
        </section>

        <!-- SECTION 5: DASHBOARD -->
        <section id="dashboard" class="py-16 bg-white">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Dashboard Header -->
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <h2 class="text-2xl sm:text-4xl font-bold text-[#12519C] mb-3">Awareness & Data Dashboard</h2>
                    <p class="text-gray-600 text-sm sm:text-base">
                        Understanding statistics helps build better awareness and informed school safety policies.
                    </p>
                </div>

                <!-- Dashboard Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                    <!-- Chart 1: Map Chart (Regional Breakdown) -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-base font-bold text-[#12519C]">Global Bullying Impact</h3>
                                <span class="bg-[#F6C401] text-gray-900 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">Sample data</span>
                            </div>

                            <!-- Map Visual Representation (SVG World Map Graphic + Chart breakdown) -->
                            <div class="relative w-full h-36 bg-blue-50/50 rounded-xl mb-4 overflow-hidden flex items-center justify-center p-2 border border-blue-100">
                                <svg class="w-full h-full text-blue-200 opacity-80" viewBox="0 0 1000 500" fill="currentColor">
                                    <!-- Simplified SVG Map Shape -->
                                    <path d="M150,150 Q200,100 250,150 T300,250 T200,350 T100,250 Z M450,120 Q500,80 550,120 T600,200 T500,280 Z M700,180 Q800,120 880,200 T800,320 T720,250 Z M220,380 Q250,350 280,400 T240,460 Z" />
                                    <!-- Location Ping Dots -->
                                    <circle cx="220" cy="200" r="12" class="fill-[#12519C] animate-pulse" opacity="0.8" />
                                    <circle cx="510" cy="180" r="15" class="fill-[#27A0DB] animate-pulse" opacity="0.8" />
                                    <circle cx="780" cy="240" r="10" class="fill-[#F6C401] animate-pulse" opacity="0.9" />
                                    <circle cx="250" cy="410" r="14" class="fill-[#12519C] animate-pulse" opacity="0.8" />
                                </svg>
                                <div class="absolute inset-0 flex items-center justify-center bg-white/30 backdrop-blur-[1px]">
                                    <span class="text-xs font-bold text-[#12519C] bg-white/90 px-3 py-1 rounded-full shadow-xs">Regional Incidences Map</span>
                                </div>
                            </div>

                            <div class="h-44 relative">
                                <canvas id="mapChart"></canvas>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 text-center mt-3 border-t border-gray-100 pt-3">
                            Regional survey distribution metrics
                        </p>
                    </div>

                    <!-- Chart 2: Pie Chart (Bullying Types) -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-base font-bold text-[#12519C]">Types of Bullying</h3>
                                <span class="bg-[#F6C401] text-gray-900 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">Sample data</span>
                            </div>

                            <div class="h-56 relative flex items-center justify-center">
                                <canvas id="pieChart"></canvas>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 text-center mt-3 border-t border-gray-100 pt-3">
                            Proportions of reported bullying formats
                        </p>
                    </div>

                    <!-- Chart 3: Pictorial Chart (1 in 3 Students Highlight) -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-base font-bold text-[#12519C]">Affected Student Ratio</h3>
                                <span class="bg-[#F6C401] text-gray-900 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">Sample data</span>
                            </div>

                            <p class="text-xs text-gray-600 mb-3 font-semibold text-center">
                                Each icon represents 1% of total student population
                            </p>

                            <!-- Pictogram Display Grid (100 Person Icons) -->
                            <div id="pictogram-grid" class="grid grid-cols-10 gap-1.5 p-3 bg-gray-50 rounded-xl border border-gray-100 max-w-[280px] mx-auto">
                                <!-- Generated by JS loop -->
                            </div>

                            <div class="mt-4 text-center">
                                <span class="text-2xl font-black text-[#12519C]">33%</span>
                                <span class="text-xs font-bold text-gray-700 block">Experience Regular Bullying</span>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 text-center mt-3 border-t border-gray-100 pt-3">
                            Highlighting 1 in 3 affected student ratio
                        </p>
                    </div>

                </div>
            </div>
        </section>

        <!-- SECTION 6: GET HELP -->
        <section id="get-help" class="py-16 bg-blue-50/40 border-t border-gray-100">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Section Header -->
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <span class="inline-block px-3 py-1 rounded-full bg-[#12519C] text-white text-xs font-bold tracking-wider uppercase mb-3">
                        Reach Out Confidentiality
                    </span>
                    <h2 class="text-3xl sm:text-5xl font-extrabold text-[#12519C] mb-4">Get Help</h2>
                    <p class="text-gray-700 text-base sm:text-lg font-medium">
                        If you don't feel safe, talk to the counselor in the Wellness Department. Your privacy is protected and respected.
                    </p>
                </div>

                <!-- Contact Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                    <!-- Contact Card 1: Email Counselor -->
                    <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm flex flex-col justify-between hover:border-[#27A0DB] transition-all">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#12519C] flex items-center justify-center mb-4">
                                <!-- Mail SVG Icon -->
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <h3 class="text-lg font-bold text-[#12519C] mb-1">Wellness Department</h3>
                            <p class="text-xs text-gray-500 mb-4">Official confidential email support</p>
                        </div>
                        <div>
                            <a href="mailto:studentwellnessdepartment@goldenvalley.ed.cr" class="text-xs sm:text-sm font-bold text-[#27A0DB] hover:text-[#12519C] break-all block py-2 px-3 bg-blue-50/50 rounded-lg hover:bg-blue-100 transition-colors">
                                studentwellnessdepartment@goldenvalley.ed.cr
                            </a>
                            <button onclick="copyToClipboard('studentwellnessdepartment@goldenvalley.ed.cr', 'email-copy-msg')" class="mt-2 text-xs text-gray-500 hover:text-gray-800 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                <span>Copy email</span>
                            </button>
                            <span id="email-copy-msg" class="text-[11px] text-green-600 hidden font-bold mt-1">Copied!</span>
                        </div>
                    </div>

                    <!-- Contact Card 2: Phone Counselor -->
                    <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-sm flex flex-col justify-between hover:border-[#27A0DB] transition-all">
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#27A0DB] flex items-center justify-center mb-4">
                                <!-- Phone SVG Icon -->
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                            </div>
                            <h3 class="text-lg font-bold text-[#12519C] mb-1">Direct Phone Line</h3>
                            <p class="text-xs text-gray-500 mb-4">Counselor direct telephone extension</p>
                        </div>
                        <div>
                            <a href="tel:50667671076" class="text-base sm:text-lg font-bold text-[#12519C] hover:text-[#27A0DB] block py-2 px-3 bg-blue-50/50 rounded-lg hover:bg-blue-100 transition-colors">
                                506 6767 1076
                            </a>
                            <button onclick="copyToClipboard('506 6767 1076', 'phone-copy-msg')" class="mt-2 text-xs text-gray-500 hover:text-gray-800 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                <span>Copy phone</span>
                            </button>
                            <span id="phone-copy-msg" class="text-[11px] text-green-600 hidden font-bold mt-1">Copied!</span>
                        </div>
                    </div>

                    <!-- Contact Card 3: Emergency Highlight Card -->
                    <div class="p-6 rounded-2xl bg-white border-2 border-[#F6C401] shadow-md flex flex-col justify-between relative overflow-hidden">
                        <div class="absolute top-0 right-0 bg-[#F6C401] text-gray-900 text-[10px] font-extrabold uppercase px-3 py-1 rounded-bl-lg">
                            Urgent Emergency
                        </div>
                        <div>
                            <div class="w-12 h-12 rounded-xl bg-yellow-100 text-yellow-800 flex items-center justify-center mb-4">
                                <!-- Bell / Alert SVG Icon -->
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                                </svg>
                            </div>
                            <h3 class="text-lg font-bold text-[#12519C] mb-1">Emergency Service</h3>
                            <p class="text-xs text-gray-600 mb-4">For immediate danger or high crisis situations</p>
                        </div>
                        <div>
                            <a href="tel:911" class="text-2xl font-black text-red-600 hover:text-red-700 block py-2 px-3 bg-red-50 rounded-lg text-center hover:bg-red-100 transition-colors tracking-widest">
                                911
                            </a>
                            <p class="text-[11px] text-gray-500 text-center mt-2">Available 24/7 National Emergency Hotline</p>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </main>

    <!-- SECTION 7: FOOTER -->
    <footer class="bg-white border-t border-gray-200 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Thin Three Color Accent Bar -->
            <div class="w-24 h-1 flex mx-auto mb-6 rounded-full overflow-hidden">
                <div class="w-1/3 bg-[#12519C]"></div>
                <div class="w-1/3 bg-[#27A0DB]"></div>
                <div class="w-1/3 bg-[#F6C401]"></div>
            </div>

            <div class="text-center">
                <p class="text-base font-bold text-[#12519C] mb-1">Safe Spaces</p>
                <p class="text-sm text-gray-600 font-medium">Golden Valley School, 2026</p>
                <p class="text-xs text-gray-400 mt-4">Dedicated to protecting student well-being and privacy.</p>
            </div>
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Mobile Menu Toggle Logic
            const menuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const menuIconOpen = document.getElementById('menu-icon-open');
            const menuIconClose = document.getElementById('menu-icon-close');
            const mobileLinks = document.querySelectorAll('.mobile-link');

            if (menuBtn) {
                menuBtn.addEventListener('click', function() {
                    const isHidden = mobileMenu.classList.contains('hidden');
                    if (isHidden) {
                        mobileMenu.classList.remove('hidden');
                        menuIconOpen.classList.add('hidden');
                        menuIconClose.classList.remove('hidden');
                    } else {
                        mobileMenu.classList.add('hidden');
                        menuIconOpen.classList.remove('hidden');
                        menuIconClose.classList.add('hidden');
                    }
                });
            }

            // Close mobile menu when link is clicked
            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    menuIconOpen.classList.remove('hidden');
                    menuIconClose.classList.add('hidden');
                });
            });

            // 2. Pictogram Chart Generator (100 Person Icons, 33 highlighted for 1 in 3)
            const pictogramContainer = document.getElementById('pictogram-grid');
            if (pictogramContainer) {
                const totalIcons = 100;
                const highlightedCount = 33; // 1 in 3 ratio (~33%)

                for (let i = 0; i < totalIcons; i++) {
                    const isHighlighted = i < highlightedCount;
                    const iconSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                    iconSvg.setAttribute('viewBox', '0 0 24 24');
                    iconSvg.setAttribute('class', `w-5 h-5 person-icon ${isHighlighted ? 'text-[#12519C]' : 'text-gray-200'}`);
                    iconSvg.setAttribute('fill', 'currentColor');

                    // Standard User SVG path
                    iconSvg.innerHTML = `<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>`;
                    pictogramContainer.appendChild(iconSvg);
                }
            }

            // 3. Chart.js Initialization
            
            // Map Breakdown Bar Chart
            const ctxMap = document.getElementById('mapChart');
            if (ctxMap) {
                new Chart(ctxMap, {
                    type: 'bar',
                    data: {
                        labels: ['Latin Amer.', 'North Amer.', 'Europe', 'Asia Pac.'],
                        datasets: [{
                            label: 'Incidence %',
                            data: [35, 28, 29, 32],
                            backgroundColor: ['#12519C', '#27A0DB', '#64B5F6', '#F6C401'],
                            borderRadius: 6,
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return ` Sample Rate: ${context.raw}%`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                max: 50,
                                grid: { display: false },
                                ticks: { font: { family: 'Arial', size: 10 } }
                            },
                            y: {
                                grid: { display: false },
                                ticks: { font: { family: 'Arial', size: 10 } }
                            }
                        }
                    }
                });
            }

            // Pie Chart (Bullying Types)
            const ctxPie = document.getElementById('pieChart');
            if (ctxPie) {
                new Chart(ctxPie, {
                    type: 'doughnut',
                    data: {
                        labels: ['Verbal', 'Social', 'Cyber', 'Physical'],
                        datasets: [{
                            data: [42, 28, 18, 12],
                            backgroundColor: ['#12519C', '#27A0DB', '#64B5F6', '#F6C401'],
                            borderWidth: 2,
                            borderColor: '#FFFFFF'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    font: { family: 'Arial', size: 11 },
                                    boxWidth: 12,
                                    padding: 10
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return ` ${context.label}: ${context.raw}%`;
                                    }
                                }
                            }
                        },
                        cutout: '60%'
                    }
                });
            }
        });

        // Copy text to clipboard helper
        function copyToClipboard(text, targetMsgId) {
            const tempInput = document.createElement('input');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            const msgEl = document.getElementById(targetMsgId);
            if (msgEl) {
                msgEl.classList.remove('hidden');
                setTimeout(() => {
                    msgEl.classList.add('hidden');
                }, 2000);
            }
        }
    </script>
</body>
